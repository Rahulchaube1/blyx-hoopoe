use std::cli;
use console;
use hoopoe;

fn main() {
    let argv = cli_args();
    let count = args_len(argv);
    if count == 1 && args_at(argv, 0) == "--help" {
        println!("Plan a thumbnail and check the decoded pixel buffer against a byte budget.");
        println!("Usage: hoopoe width height box_w box_h channels align memory");
        println!("Vector arguments are comma-separated; use [] for an empty vector.");
        return;
    }
    let mut result = [];
    if count == 0 {
        result = hoopoe_thumbnail(400.0, 200.0, 100.0, 100.0, 3.0, 4.0, 14000.0);
    } else {
        if count != 7 { stderr_line("Wrong argument count. Use --help."); process_exit(2); }
        let width = console_value(args_at(argv, 0));
        let height = console_value(args_at(argv, 1));
        let box_w = console_value(args_at(argv, 2));
        let box_h = console_value(args_at(argv, 3));
        let channels = console_value(args_at(argv, 4));
        let align = console_value(args_at(argv, 5));
        let memory = console_value(args_at(argv, 6));
        result = hoopoe_thumbnail(width, height, box_w, box_h, channels, align, memory);
    }
    if len(result) == 0 { stderr_line("Invalid input for Hoopoe. See the package input contract."); process_exit(1); }
    let mut i = 0;
    while i < len(result) {
        println!(at(result, i));
        i += 1;
    }
}
